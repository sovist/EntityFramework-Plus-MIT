  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG;RELEASE;NETCOREAPP2_0; EFCORE; FULL EFCORE_3X EFCORE_5X EFCORE_6X EFCORE_7X EFCORE_8X EFCORE_9X EFCORE_10X IsCore7</DefineConstants>
