    <Compile Remove="..\..\Z.Test.EntityFramework.Plus.EFCore.Shared\BatchUpdate\**" />
    <Compile Remove="..\..\Z.Test.EntityFramework.Plus.EFCore.Shared\MikaelAreaIndependant\IncludeFilter_694.cs" />
    <Compile Remove="..\..\Z.Test.EntityFramework.Plus.EFCore.Shared\MikaelAreaIndependant\QueryCache.cs" />
    <Compile Remove="..\..\Z.Test.EntityFramework.Plus.EFCore.Shared\MikaelAreaIndependant\Autre.cs" />
    <Compile Remove="..\..\Z.Test.EntityFramework.Plus.EFCore.Shared\MikaelAreaIndependant\UpdateFromQueryDic.cs" />
    <!-- The EFCore90 project's own QueryIncludeOptimized tests, compiled from where they live rather than copied. -->
    <Compile Include="..\Z.Test.EntityFramework.Plus.EFCore90\QueryIncludeOptimized\**\*.cs" />
